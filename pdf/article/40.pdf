      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Insights into Two-Metal-Ion Catalytic Mechanism of Cap-Snatching Endonuclease of Ebinur Lake Virus in Bunyavirales</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/jvi.02085-21</rdf:li>
        </rdf:Alt>
      </dc:identifier>
