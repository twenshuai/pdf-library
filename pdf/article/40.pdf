          <rdf:li>Huanyu Zhang</rdf:li>
          <rdf:li>Yan Cai</rdf:li>
          <rdf:li>Guilin Zhang</rdf:li>
          <rdf:li>Fei Deng</rdf:li>
          <rdf:li>Hailong Li</rdf:li>
          <rdf:li>Zhihong Hu</rdf:li>
          <rdf:li>Yu Guo</rdf:li>
          <rdf:li>Manli Wang</rdf:li>
          <rdf:li>Yiwu Zhou</rdf:li>
          <rdf:li>Peng Gong</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Genome Replication and Regulation of Viral Gene Expression</rdf:li>
          <rdf:li xml:lang="x-repair">Genome Replication and Regulation of Viral Gene Expression</rdf:li>
